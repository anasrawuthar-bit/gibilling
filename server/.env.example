# ==============================================================================
# ZynBill Cloud Server Environment Configuration
# ==============================================================================

# Server Network & Mode
PORT=4000
NODE_ENV=production

# Super Administrator Credentials
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=admin@yourdomain.in
SUPER_ADMIN_PASSWORD=Admin@123456

# Database Engine Selection: 'postgres' for production cloud, or 'sqlite' for local
DB_TYPE=sqlite

# PostgreSQL Connection Settings (When DB_TYPE=postgres)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zynbill_cloud
PG_USER=postgres
PG_PASSWORD=
PG_SSL=false

# SMTP Mail Server Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZynBill Cloud" <notifications@yourdomain.in>
